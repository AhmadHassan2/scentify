# ─────────────────────────────────────────────────────────────
# Scentify environment configuration
# Every variable is optional. With none set, the app runs in
# "demo mode": synthetic catalog in memory, a local demo account,
# user data persisted to ./.data/demo-store.json, and example weather.
# ─────────────────────────────────────────────────────────────

# Supabase (enables real auth + Postgres persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed/sync scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Catalog source: "local" reads the bundled synthetic dataset,
# "supabase" reads the fragrances tables. Defaults to "supabase" when
# Supabase is configured, otherwise "local".
CATALOG_SOURCE=

# OpenAI (enables the LLM-powered assistant; without it the assistant
# uses the built-in deterministic query parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Weather: "live" uses Open-Meteo (free, no key), "demo" uses example weather.
WEATHER_MODE=live

# Display currency for synthetic prices (only CAD is populated today)
NEXT_PUBLIC_DEFAULT_CURRENCY=CAD
